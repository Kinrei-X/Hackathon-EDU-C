#include <stdio.h>

int main()
{
    int correctPIN = 1234;
    int enteredPIN;
    int attempts = 0;
    int loginSuccess = 0;

    int choice;
    int inputStatus;

    double balance = 10000;
    double depositAmount;
    double withdrawAmount;

    double totalDeposited = 0;
    double totalWithdrawn = 0;
    int transactionCount = 0;

    printf("====================================\n");
    printf("       SMART ATM SIMULATOR\n");
    printf("====================================\n");

    /* PIN SECURITY SYSTEM */
    while (attempts < 3)
    {
        printf("\nEnter your PIN: ");
        inputStatus = scanf("%d", &enteredPIN);

        if (inputStatus != 1)
        {
            printf("Invalid input! Enter numbers only.\n");

            while (getchar() != '\n')
            {
            }

            continue;
        }

        if (enteredPIN == correctPIN)
        {
            loginSuccess = 1;
            printf("\nLogin successful!\n");
            break;
        }
        else
        {
            attempts++;
            printf("Wrong PIN! Attempts remaining: %d\n", 3 - attempts);
        }
    }

    if (loginSuccess == 0)
    {
        printf("\nCard Blocked. Too many failed attempts.\n");
        return 0;
    }

    /* MAIN ATM MENU */
    do
    {
        printf("\n====================================\n");
        printf("             ATM MENU\n");
        printf("====================================\n");
        printf("1. Check Balance\n");
        printf("2. Deposit Money\n");
        printf("3. Withdraw Money\n");
        printf("4. Session Summary\n");
        printf("5. Exit\n");
        printf("====================================\n");
        printf("Enter your choice: ");

        inputStatus = scanf("%d", &choice);

        if (inputStatus != 1)
        {
            printf("Invalid option! Please enter a number.\n");

            while (getchar() != '\n')
            {
            }

            choice = 0;
            continue;
        }

        switch (choice)
        {
            /* CHECK BALANCE */
            case 1:
                printf("\nCurrent Balance: %.2lf BDT\n", balance);
                break;

            /* DEPOSIT */
            case 2:
                printf("\nEnter deposit amount: ");
                inputStatus = scanf("%lf", &depositAmount);

                if (inputStatus != 1)
                {
                    printf("Invalid amount input!\n");

                    while (getchar() != '\n')
                    {
                    }

                    break;
                }

                if (depositAmount <= 0)
                {
                    printf("Deposit amount must be greater than zero!\n");
                }
                else
                {
                    balance += depositAmount;
                    totalDeposited += depositAmount;
                    transactionCount++;

                    printf("Deposit successful!\n");
                    printf("Deposited: %.2lf BDT\n", depositAmount);
                    printf("New Balance: %.2lf BDT\n", balance);
                }
                break;

            /* WITHDRAW */
            case 3:
                printf("\nEnter withdrawal amount: ");
                inputStatus = scanf("%lf", &withdrawAmount);

                if (inputStatus != 1)
                {
                    printf("Invalid amount input!\n");

                    while (getchar() != '\n')
                    {
                    }

                    break;
                }

                if (withdrawAmount <= 0)
                {
                    printf("Withdrawal amount must be greater than zero!\n");
                }
                else if (withdrawAmount > balance)
                {
                    printf("Insufficient funds!\n");
                }
                else if (totalWithdrawn + withdrawAmount > 15000)
                {
                    printf("Session withdrawal limit of 15000 BDT exceeded!\n");
                    printf("You can withdraw only %.2lf BDT more.\n",
                           15000 - totalWithdrawn);
                }
                else
                {
                    balance -= withdrawAmount;
                    totalWithdrawn += withdrawAmount;
                    transactionCount++;

                    printf("Withdrawal successful!\n");
                    printf("Withdrawn: %.2lf BDT\n", withdrawAmount);
                    printf("Remaining Balance: %.2lf BDT\n", balance);
                }
                break;

            /* SESSION SUMMARY */
            case 4:
                printf("\n========== SESSION SUMMARY ==========\n");
                printf("Total Deposited  : %.2lf BDT\n", totalDeposited);
                printf("Total Withdrawn  : %.2lf BDT\n", totalWithdrawn);
                printf("Transactions     : %d\n", transactionCount);
                printf("Current Balance  : %.2lf BDT\n", balance);
                printf("==================================\n");
                break;

            /* EXIT */
            case 5:
                printf("\n========== FINAL RECEIPT ==========\n");
                printf("Total Deposited  : %.2lf BDT\n", totalDeposited);
                printf("Total Withdrawn  : %.2lf BDT\n", totalWithdrawn);
                printf("Transactions     : %d\n", transactionCount);
                printf("Final Balance   : %.2lf BDT\n", balance);
                printf("=================================\n");
                printf("Thank you for using Smart ATM!\n");
                break;

            /* INVALID OPTION */
            default:
                printf("\nInvalid option! Please select 1-5.\n");
        }

    } while (choice != 5);

    return 0;
}